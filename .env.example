# Asli — Environment Variables
# Copy this file to .env and fill in your values.

# Required: Gemini API key for AI-powered analysis
GEMINI_API_KEY=your_gemini_api_key_here

# Required: Google Cloud project ID
GOOGLE_CLOUD_PROJECT=your_gcp_project_id

# Optional: path to Firebase service account JSON (leave empty to run without Firebase)
FIREBASE_KEY_PATH=/absolute/path/to/firebasekey.json

# Optional: path to local Xception model weights (.h5 file)
IMAGE_MODEL_PATH=/absolute/path/to/models/xception_5o.h5

# Which output index of the Keras model represents the "fake" probability
MODEL_PROBABILITY_INDEX=1

# Label the model assigns to fake images (used to orient the score)
MODEL_HIGH_VALUE_LABEL=fake

# Max video frames to sample per video analysis
VIDEO_MAX_FRAMES=12

# Server port (default 8000)
PORT=8000
