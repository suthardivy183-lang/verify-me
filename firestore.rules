// Deploy with: firebase deploy --only firestore:rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user's profile doc (settings) — only the owner can read or write
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Each user's scan history — only the owner can read or write
    match /users/{userId}/scans/{scanId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Global scan counter — anyone can read (social proof),
    // any request (including guests) can increment
    match /stats/global {
      allow read:  if true;
      allow write: if true;
    }
  }
}
